# Copy this file to `.env` and fill in real values for local development.
# `.env` is gitignored; this file is committed as documentation.
#
# NOTE: every VITE_-prefixed variable is inlined into the production JS bundle
# at build time and is therefore PUBLIC. Never put a real secret here.
# Values that must stay private belong on the Java backend, not in this app.

# Base URL of the vobar-backend Java API, including the /api prefix.
# Local dev: the backend running on port 8080.
# Production: https://api.vobar.dev/api, set as a GitHub repository variable (not here).
VITE_API_URL=http://localhost:8080/api

# EmailJS (contact form). These are public by design — EmailJS calls the last one
# a "public key". The domain allowlist that would restrict them is a paid EmailJS
# feature, so on the free plan they are effectively unprotected; the blast radius
# is the 200-request/month quota.
VITE_SERVICE_ID=
VITE_TEMPLATE_ID=
VITE_PUBLIC_KEY=
